{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat .env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "allow": []
  },
  "enabledPlugins": {
    "standards@synced": false,
    "standards@claude-code-skills": false,
    "engineering@synced": false,
    "engineering@claude-code-skills": false
  },
  "skillOverrides": {
    "agent-engineering": "off",
    "algorithmic-art": "off",
    "canvas-design": "off",
    "code-planner": "off",
    "doc-coauthoring": "off",
    "docs": "name-only",
    "git-workflows": "off",
    "google-workspace": "name-only",
    "house-style": "off",
    "import-memory": "off",
    "internal-comms": "off",
    "markdown-standards": "off",
    "morning": "off",
    "procedure-generator": "off",
    "project-bootstrap-and-audit": "off",
    "skill-creator": "on",
    "skill-orchestrator": "off",
    "skill-stress-tester": "off",
    "slack-gif-creator": "off",
    "web-artifacts-builder": "off"
  }
}
