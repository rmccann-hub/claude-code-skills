{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat .env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "allow": []
  },
  "enabledPlugins": {
    "standards@synced": false,
    "standards@claude-code-skills": false,
    "engineering@synced": false,
    "engineering@claude-code-skills": false
  },
  "skillOverrides": {
    "code-planner": "off",
    "git-workflows": "off",
    "markdown-standards": "off",
    "project-bootstrap-and-audit": "off",
    "skill-orchestrator": "off",
    "skill-stress-tester": "off"
  }
}
