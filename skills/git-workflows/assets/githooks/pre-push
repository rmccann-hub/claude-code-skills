#!/bin/sh
# Refuses a push that updates the default branch directly. Git passes the refs
# being pushed on standard input, one line each:
#   <local ref> <local object> <remote ref> <remote object>
# so this checks what is being pushed, not which branch is checked out.
protected=refs/heads/main
status=0
while read -r local_ref _ remote_ref _; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "pre-push: refusing to push $local_ref to $protected; open a pull request" >&2
    status=1
  fi
done
exit "$status"
